# Public base URL used in generated TwiML callback URLs
APP_BASE_URL=

# Twilio credentials and numbers
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=+1XXXXXXXXXX

# Where to connect high-priority calls and send SMS summaries
FORWARD_TO=+1YYYYYYYYYY

# OpenAI for classification
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database (SQLite by default)
DATABASE_URL=sqlite+aiosqlite:///./calls.db

# Behavior flags
RECRUITER_ALWAYS_CONNECT=true
TIMEZONE=America/Chicago

