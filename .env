# Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_NUMBER=+1XXXXXXXXXX
FORWARD_TO=+1YYYYYYYYYY   # Your personal phone number to forward high-priority calls

# OpenAI credentials
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# App configuration
APP_BASE_URL=https://your-public-url.com   # e.g., https://yourapp.onrender.com
DATABASE_URL=sqlite+aiosqlite:///./calls.db

# Bot behavior
RECRUITER_ALWAYS_CONNECT=true
TIMEZONE=America/Chicago
